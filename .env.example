# Server only. Copy to .env.production with mode 600 while editing, then 400.
NODE_ENV=production
# Exact public browser origin (scheme + hostname + optional port), used for CSRF checks and cookies.
APP_ORIGIN=https://app.example.com
# Optional override of app/config/origins.ts: comma-separated additional HTTPS origins.
# Set to an empty string to disable preview origins on a production-only deployment.
# APP_ADDITIONAL_ORIGINS=
# GoDaddy managed Node.js: enable its managed MySQL database. GoDaddy supplies
# these five runtime variables. Their presence selects MySQL automatically.
# DATABASE_PATH is not required for MySQL. Never commit real credentials.
# DATABASE_DRIVER=mysql
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# Google Cloud SQL Unix socket (takes precedence over DB_HOST/DB_PORT):
# DATABASE_DRIVER=mysql
# DB_SOCKET_PATH=/cloudsql/fieldora-testing:asia-south1:<INSTANCE_ID>
# Set DB_NAME, DB_USER and DB_PASSWORD above through server-side secrets.
# Mount the socket using the platform Cloud SQL integration or Cloud SQL Auth Proxy.
# The proxy/integration secures the Cloud SQL connection; DB_SSL is not needed for it.
# Optional verified TLS for servers that require it; DB_SSL_CA accepts PEM with \n separators.
# DB_SSL=true
# DB_SSL_CA=
# Existing SQLite/VPS installations only (ignored when MySQL is selected):
# DATABASE_DRIVER=sqlite
# DATABASE_PATH=/srv/ptraam/data/ptraam.sqlite
GOOGLE_SPREADSHEET_ID=
GOOGLE_SPREADSHEET_TITLE='PTRAAM Enterprises'
GOOGLE_CLIENT_EMAIL=
# Literal backslash-n separators are supported by lib/sheets-sync.ts.
GOOGLE_PRIVATE_KEY=
GOOGLE_REPORT_VIEWERS='{"+919600043768":"ptramkumaarenterprises25@gmail.com","+919940180612":["mohanagane08@gmail.com","chennaigane@gmail.com"]}'
WORKFORCE_JOB_TOKEN=
EMERGENCY_WEBHOOK_URL=
EMERGENCY_WEBHOOK_SECRET=
EMERGENCY_ALERT_RECIPIENTS=ptramkumaarenterprises25@gmail.com,mohanagane08@gmail.com,chennaigane@gmail.com
