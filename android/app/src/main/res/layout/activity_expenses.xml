<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fieldora_background"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_horizontal_padding">
    <TextView android:text="@string/expense_entry" style="@style/Fieldora.Text.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Spinner android:id="@+id/expense_trip" android:layout_width="match_parent" android:layout_height="@dimen/input_height" android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_input_default" />
    <EditText android:id="@+id/expense_amount" style="@style/Fieldora.Input" android:hint="Other expense amount (INR)" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" />
    <EditText android:id="@+id/expense_note" style="@style/Fieldora.Input" android:hint="Notes" android:inputType="textCapSentences|textMultiLine" android:minLines="3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" />
    <TextView android:id="@+id/expense_message" style="@style/Fieldora.Text.Body.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" />
    <Button android:id="@+id/expense_submit" style="@style/Fieldora.Button.Primary" android:text="Submit expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" />
    <Button android:id="@+id/expense_back" style="@style/Fieldora.Button.Secondary" android:text="@string/home" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" />
</LinearLayout></ScrollView>
