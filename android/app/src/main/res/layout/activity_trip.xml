<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/screen_horizontal_padding" android:background="@color/fieldora_background">
    <TextView android:text="@string/trips" style="@style/Fieldora.Text.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout style="@style/Fieldora.Card.Trip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/space_lg">
        <TextView android:id="@+id/trip_screen_status" style="@style/Fieldora.Text.SectionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/trip_screen_details" style="@style/Fieldora.Text.Body.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" />
        <Button android:id="@+id/trip_open_controls" style="@style/Fieldora.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" />
    </LinearLayout>
    <Button android:id="@+id/trip_back" style="@style/Fieldora.Button.Secondary" android:text="@string/home" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" />
</LinearLayout>
