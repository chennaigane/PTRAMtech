<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fieldora_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_horizontal_padding">
        <TextView android:text="@string/dashboard_brand" style="@style/Fieldora.Text.Status" android:textColor="@color/fieldora_primary" android:letterSpacing="0.18" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/work_title" style="@style/Fieldora.Text.ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" />
        <LinearLayout style="@style/Fieldora.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/space_lg">
            <TextView android:id="@+id/work_message" style="@style/Fieldora.Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="Requests are not stored offline. This prevents duplicate or conflicting submissions." style="@style/Fieldora.Text.Body.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" />
            <Button android:id="@+id/open_portal" style="@style/Fieldora.Button.Primary" android:text="@string/open_web_portal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_lg" />
            <Button android:id="@+id/work_back" style="@style/Fieldora.Button.Secondary" android:text="@string/cancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
