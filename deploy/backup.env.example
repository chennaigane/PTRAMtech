# Install outside app source, e.g. /etc/ptraam/backup.env, root:root mode 600.
# Initialize a remote restic repository and retain the encryption password in
# an independently recoverable company secret store before enabling the timer.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_CACHE_DIR=/srv/ptraam/data/restic-cache
# Add repository-specific credentials here. Never put them in argv or Git.
