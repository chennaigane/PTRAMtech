[Unit]
Description=PTRAAM daily attendance reconciliation
After=network-online.target ptraam.service

[Service]
Type=oneshot
User=ptraam
Group=ptraam
WorkingDirectory=/srv/ptraam/app
EnvironmentFile=/srv/ptraam/app/.env.production
ExecStart=/usr/bin/node /srv/ptraam/app/scripts/workforce-job.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
